<odoo>
    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.form.l10n_de_hr_attendance_arbzg</field>
        <field name="model">hr.employee</field>
        <field
            name="inherit_id"
            ref="hr_attendance.view_employee_form_inherit_hr_attendance"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='attendance_manager_id']" position="after">
                <field name="arbzg_exempt" groups="hr.group_hr_user" />
            </xpath>
        </field>
    </record>
</odoo>
