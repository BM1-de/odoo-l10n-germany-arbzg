<odoo>
    <record id="view_attendance_tree" model="ir.ui.view">
        <field name="name">hr.attendance.list.l10n_de_hr_attendance_arbzg</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='worked_hours']" position="after">
                <field
                    name="arbzg_missing_break"
                    optional="show"
                    decoration-danger="arbzg_missing_break &gt; 0"
                />
            </xpath>
        </field>
    </record>
    <record id="hr_attendance_view_form" model="ir.ui.view">
        <field name="name">hr.attendance.form.l10n_de_hr_attendance_arbzg</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='check_out']" position="after">
                <field name="arbzg_missing_break" invisible="not arbzg_missing_break" />
            </xpath>
        </field>
    </record>
</odoo>
