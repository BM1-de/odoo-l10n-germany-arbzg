#. module: l10n_de_hr_attendance_arbzg
#: model_terms:ir.ui.view,arch_db:l10n_de_hr_attendance_arbzg.res_config_settings_view_form
msgid "Activity for"
msgstr "Aufgabe für"

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model,name:l10n_de_hr_attendance_arbzg.model_hr_attendance
msgid "Attendance"
msgstr "Anwesenheit"

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model.fields,help:l10n_de_hr_attendance_arbzg.field_hr_attendance__arbzg_missing_break
msgid ""
"Break that is missing on this day according to the Working Time Act, if it "
"was only pointed out and not inserted."
msgstr "Pause, die an diesem Tag laut Arbeitszeitgesetz fehlt, wenn sie nur angezeigt und nicht eingefügt wurde."

#. module: l10n_de_hr_attendance_arbzg
#: model_terms:ir.ui.view,arch_db:l10n_de_hr_attendance_arbzg.res_config_settings_view_form
msgid "Breaks"
msgstr "Pausen"

#. module: l10n_de_hr_attendance_arbzg
#: model_terms:ir.ui.view,arch_db:l10n_de_hr_attendance_arbzg.res_config_settings_view_form
msgid ""
"Breaks per day (§ 4 ArbZG). Gaps between attendances count from the shortest"
" break on."
msgstr "Pausen pro Tag (§ 4 ArbZG). Lücken zwischen Anwesenheiten zählen ab der kürzesten Pause."

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model.fields,field_description:l10n_de_hr_attendance_arbzg.field_res_company__arbzg_auto_check_out
#: model:ir.model.fields,field_description:l10n_de_hr_attendance_arbzg.field_res_config_settings__arbzg_auto_check_out
msgid "Check Out at the Maximum"
msgstr "Bei Höchstarbeitszeit ausstempeln"

#. module: l10n_de_hr_attendance_arbzg
#: model_terms:ir.ui.view,arch_db:l10n_de_hr_attendance_arbzg.res_config_settings_view_form
msgid "Check out automatically at the maximum"
msgstr "Bei Erreichen der Höchstarbeitszeit automatisch ausstempeln"

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model.fields,help:l10n_de_hr_attendance_arbzg.field_res_company__arbzg_auto_check_out
#: model:ir.model.fields,help:l10n_de_hr_attendance_arbzg.field_res_config_settings__arbzg_auto_check_out
msgid ""
"Check out employees who forgot to check out as soon as the maximum working "
"time of the day is reached (checked every 15 minutes)."
msgstr "Wer das Ausstempeln vergessen hat, wird ausgestempelt, sobald die Höchstarbeitszeit des Tages erreicht ist (Prüfung alle 15 Minuten)."

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model.fields,help:l10n_de_hr_attendance_arbzg.field_res_company__arbzg_enabled
#: model:ir.model.fields,help:l10n_de_hr_attendance_arbzg.field_res_config_settings__arbzg_enabled
msgid ""
"Check the legal breaks (§ 4 ArbZG) and the daily maximum working time (§ 3 "
"ArbZG) on every attendance of the employees of this company."
msgstr "Bei jeder Anwesenheit der Mitarbeiter dieser Firma die gesetzlichen Pausen (§ 4 ArbZG) und die tägliche Höchstarbeitszeit (§ 3 ArbZG) prüfen."

#. module: l10n_de_hr_attendance_arbzg
#: model_terms:ir.ui.view,arch_db:l10n_de_hr_attendance_arbzg.res_config_settings_view_form
msgid ""
"Check the legal breaks and the daily maximum working time on every "
"attendance."
msgstr "Bei jeder Anwesenheit die gesetzlichen Pausen und die tägliche Höchstarbeitszeit prüfen."

#. module: l10n_de_hr_attendance_arbzg
#. odoo-python
#: code:addons/l10n_de_hr_attendance_arbzg/models/hr_attendance.py:0
msgid ""
"Checked out automatically: the maximum working time of the day (%(maximum)s "
"hours) was reached. Please correct the actual time yourself."
msgstr "Automatisch ausgestempelt: Die Höchstarbeitszeit des Tages (%(maximum)s Std.) war erreicht. Bitte die tatsächliche Uhrzeit selbst korrigieren."

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model,name:l10n_de_hr_attendance_arbzg.model_res_company
msgid "Companies"
msgstr "Unternehmen"

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model,name:l10n_de_hr_attendance_arbzg.model_res_config_settings
msgid "Config Settings"
msgstr "Konfigurationseinstellungen"

