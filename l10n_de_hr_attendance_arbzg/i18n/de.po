#: model:ir.model.fields,field_description:l10n_de_hr_attendance_arbzg.field_res_company__display_name
#: model:ir.model.fields,field_description:l10n_de_hr_attendance_arbzg.field_res_config_settings__display_name
msgid "Display Name"
msgstr "Anzeigename"

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model,name:l10n_de_hr_attendance_arbzg.model_hr_employee
msgid "Employee"
msgstr "Mitarbeiter"

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model.fields,field_description:l10n_de_hr_attendance_arbzg.field_hr_employee__arbzg_exempt
msgid "Exempt from the Working Time Act"
msgstr "Nicht unter dem Arbeitszeitgesetz"

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model.fields,field_description:l10n_de_hr_attendance_arbzg.field_res_company__arbzg_break_minutes_1
#: model:ir.model.fields,field_description:l10n_de_hr_attendance_arbzg.field_res_config_settings__arbzg_break_minutes_1
msgid "First Break (Minutes)"
msgstr "Erste Pause (Minuten)"

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model.fields,field_description:l10n_de_hr_attendance_arbzg.field_res_company__arbzg_break_hours_1
#: model:ir.model.fields,field_description:l10n_de_hr_attendance_arbzg.field_res_config_settings__arbzg_break_hours_1
msgid "First Break After (Hours)"
msgstr "Erste Pause nach (Stunden)"

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model.fields,help:l10n_de_hr_attendance_arbzg.field_hr_employee__arbzg_exempt
msgid ""
"For example managing directors and executives (§ 18 ArbZG). Contractors and "
"freelancers are always exempt."
msgstr "Zum Beispiel Geschäftsführer und leitende Angestellte (§ 18 ArbZG). Auftragnehmer und Freiberufler sind immer ausgenommen."

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model.fields,help:l10n_de_hr_attendance_arbzg.field_res_company__arbzg_min_break_minutes
#: model:ir.model.fields,help:l10n_de_hr_attendance_arbzg.field_res_config_settings__arbzg_min_break_minutes
msgid ""
"Gaps between two attendances count as a break from this length on (breaks "
"may be split into parts of at least 15 minutes, § 4 ArbZG)."
msgstr "Lücken zwischen zwei Anwesenheiten zählen ab dieser Länge als Pause (Pausen dürfen in Abschnitte von mindestens 15 Minuten geteilt werden, § 4 ArbZG)."

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model.fields,help:l10n_de_hr_attendance_arbzg.field_res_company__arbzg_responsible_id
#: model:ir.model.fields,help:l10n_de_hr_attendance_arbzg.field_res_config_settings__arbzg_responsible_id
msgid ""
"Gets an activity when an employee worked more than the maximum. Empty: the "
"attendance approver of the employee."
msgstr "Bekommt eine Aufgabe, wenn jemand länger als die Höchstarbeitszeit gearbeitet hat. Leer: der Genehmiger der Anwesenheiten des Mitarbeiters."

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model.fields,field_description:l10n_de_hr_attendance_arbzg.field_hr_attendance__id
#: model:ir.model.fields,field_description:l10n_de_hr_attendance_arbzg.field_hr_employee__id
#: model:ir.model.fields,field_description:l10n_de_hr_attendance_arbzg.field_res_company__id
#: model:ir.model.fields,field_description:l10n_de_hr_attendance_arbzg.field_res_config_settings__id
msgid "ID"
msgstr "ID"

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model.fields.selection,name:l10n_de_hr_attendance_arbzg.selection__res_company__arbzg_break_mode__insert
msgid "Insert the missing break"
msgstr "Fehlende Pause einfügen"

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model.fields,help:l10n_de_hr_attendance_arbzg.field_res_company__arbzg_break_mode
#: model:ir.model.fields,help:l10n_de_hr_attendance_arbzg.field_res_config_settings__arbzg_break_mode
msgid ""
"Insert: the missing break is put into the middle of the longest attendance "
"of the day, which is split in two, and noted on it. Point out: the "
"attendances stay unchanged; the missing minutes are shown on the attendance "
"and the employee gets a message."
msgstr "Einfügen: Die fehlende Pause wird in die Mitte der längsten Anwesenheit des Tages gelegt, die dafür geteilt wird, und dort vermerkt. Nur anzeigen: Die Anwesenheiten bleiben unverändert; die fehlenden Minuten stehen an der Anwesenheit, und der Mitarbeiter bekommt eine Nachricht."

#. module: l10n_de_hr_attendance_arbzg
#. odoo-python
#: code:addons/l10n_de_hr_attendance_arbzg/models/hr_attendance.py:0
msgid ""
"Legal break: %(minutes)s minutes inserted automatically (%(start)s–%(end)s),"
" because no sufficient break was recorded on this day."
msgstr "Gesetzliche Pause: %(minutes)s Min. automatisch eingefügt (%(start)s–%(end)s Uhr), weil an diesem Tag keine ausreichende Pause erfasst war."

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model.fields,field_description:l10n_de_hr_attendance_arbzg.field_res_company__arbzg_break_minutes_2
#: model:ir.model.fields,field_description:l10n_de_hr_attendance_arbzg.field_res_config_settings__arbzg_break_minutes_2
msgid "Longer Break (Minutes)"
msgstr "Längere Pause (Minuten)"

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model.fields,field_description:l10n_de_hr_attendance_arbzg.field_res_company__arbzg_break_hours_2
#: model:ir.model.fields,field_description:l10n_de_hr_attendance_arbzg.field_res_config_settings__arbzg_break_hours_2
msgid "Longer Break After (Hours)"
msgstr "Längere Pause nach (Stunden)"

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model.fields,field_description:l10n_de_hr_attendance_arbzg.field_hr_attendance__arbzg_max_notified
msgid "Maximum Reported"
msgstr "Höchstarbeitszeit gemeldet"

#. module: l10n_de_hr_attendance_arbzg
#: model_terms:ir.ui.view,arch_db:l10n_de_hr_attendance_arbzg.res_config_settings_view_form
msgid "Maximum Working Time"
msgstr "Höchstarbeitszeit"

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model.fields,field_description:l10n_de_hr_attendance_arbzg.field_res_company__arbzg_max_hours
#: model:ir.model.fields,field_description:l10n_de_hr_attendance_arbzg.field_res_config_settings__arbzg_max_hours
msgid "Maximum Working Time per Day (Hours)"
msgstr "Höchstarbeitszeit pro Tag (Stunden)"

#. module: l10n_de_hr_attendance_arbzg
#: model_terms:ir.ui.view,arch_db:l10n_de_hr_attendance_arbzg.res_config_settings_view_form
msgid ""
"Maximum working time per day (§ 3 ArbZG). Longer days are reported, not "
"shortened."
msgstr "Höchstarbeitszeit pro Tag (§ 3 ArbZG). Längere Tage werden gemeldet, nicht gekürzt."

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model.fields,field_description:l10n_de_hr_attendance_arbzg.field_res_company__arbzg_break_mode
#: model:ir.model.fields,field_description:l10n_de_hr_attendance_arbzg.field_res_config_settings__arbzg_break_mode
msgid "Missing Break"
msgstr "Fehlende Pause"

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model.fields,field_description:l10n_de_hr_attendance_arbzg.field_hr_attendance__arbzg_missing_break
msgid "Missing Break (Minutes)"
msgstr "Fehlende Pause (Minuten)"

#. module: l10n_de_hr_attendance_arbzg
#. odoo-python
#: code:addons/l10n_de_hr_attendance_arbzg/models/hr_attendance.py:0
msgid "More than %(maximum)s hours of work on %(day)s"
msgstr "Über %(maximum)s Std. Arbeit am %(day)s"

#. module: l10n_de_hr_attendance_arbzg
#: model:mail.activity.type,summary:l10n_de_hr_attendance_arbzg.mail_activity_type_arbzg_maximum
msgid "More than the maximum working time of a day"
msgstr "Mehr als die Höchstarbeitszeit eines Tages"

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model.fields,help:l10n_de_hr_attendance_arbzg.field_res_company__arbzg_max_hours
#: model:ir.model.fields,help:l10n_de_hr_attendance_arbzg.field_res_config_settings__arbzg_max_hours
msgid ""
"More working time than this per day is not allowed (§ 3 ArbZG). The "
"attendances are not shortened, as they must show the real time (§ 16 (2) "
"ArbZG); the employee gets a message and the responsible person an activity."
msgstr "Mehr Arbeitszeit pro Tag ist nicht erlaubt (§ 3 ArbZG). Die Anwesenheiten werden nicht gekürzt, weil sie die tatsächliche Zeit zeigen müssen (§ 16 Abs. 2 ArbZG); der Mitarbeiter bekommt eine Nachricht und die zuständige Person eine Aufgabe."

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model.fields,help:l10n_de_hr_attendance_arbzg.field_res_company__arbzg_break_hours_1
#: model:ir.model.fields,help:l10n_de_hr_attendance_arbzg.field_res_config_settings__arbzg_break_hours_1
msgid "More working time than this per day needs the first break."
msgstr "Mehr Arbeitszeit pro Tag erfordert die erste Pause."

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model.fields,help:l10n_de_hr_attendance_arbzg.field_res_company__arbzg_break_hours_2
#: model:ir.model.fields,help:l10n_de_hr_attendance_arbzg.field_res_config_settings__arbzg_break_hours_2
msgid "More working time than this per day needs the longer break."
msgstr "Mehr Arbeitszeit pro Tag erfordert die längere Pause."

#. module: l10n_de_hr_attendance_arbzg
#. odoo-python
#: code:addons/l10n_de_hr_attendance_arbzg/models/hr_attendance.py:0
msgid ""
"On %(day)s, a break of %(minutes)s minutes is missing according to the "
"Working Time Act (§ 4 ArbZG). Please record your breaks by checking out and "
"in again, or correct the attendances."
msgstr "Am %(day)s fehlt laut Arbeitszeitgesetz eine Pause von %(minutes)s Min. (§ 4 ArbZG). Bitte Pausen durch Ab- und wieder Anmelden erfassen oder die Anwesenheiten korrigieren."

#. module: l10n_de_hr_attendance_arbzg
#. odoo-python
#: code:addons/l10n_de_hr_attendance_arbzg/models/hr_attendance.py:0
msgid ""
"On %(day)s, the attendances show %(hours)s hours of work. More than "
"%(maximum)s hours of work per day are not allowed (§ 3 ArbZG); please finish"
" work in time. If the time is wrong, please correct the attendance."
msgstr "Am %(day)s stehen %(hours)s Std. Arbeit in der Anwesenheit. Mehr als %(maximum)s Std. Arbeit am Tag sind gesetzlich nicht erlaubt (§ 3 ArbZG), bitte rechtzeitig Feierabend machen. Stimmt die Zeit nicht, bitte den Eintrag korrigieren."

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model.fields.selection,name:l10n_de_hr_attendance_arbzg.selection__res_company__arbzg_break_mode__notify
msgid "Only point out the missing break"
msgstr "Fehlende Pause nur anzeigen"

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model.fields,field_description:l10n_de_hr_attendance_arbzg.field_res_company__arbzg_responsible_id
#: model:ir.model.fields,field_description:l10n_de_hr_attendance_arbzg.field_res_config_settings__arbzg_responsible_id
msgid "Responsible for Exceeded Working Time"
msgstr "Zuständig bei überschrittener Arbeitszeit"

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model.fields,field_description:l10n_de_hr_attendance_arbzg.field_res_company__arbzg_min_break_minutes
#: model:ir.model.fields,field_description:l10n_de_hr_attendance_arbzg.field_res_config_settings__arbzg_min_break_minutes
msgid "Shortest Break (Minutes)"
msgstr "Kürzeste Pause (Minuten)"

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model.fields,help:l10n_de_hr_attendance_arbzg.field_hr_attendance__arbzg_max_notified
msgid ""
"Technical: exceeding the maximum working time of this day was already "
"reported."
msgstr "Technisch: Die Überschreitung der Höchstarbeitszeit an diesem Tag wurde schon gemeldet."

#. module: l10n_de_hr_attendance_arbzg
#. odoo-python
#: code:addons/l10n_de_hr_attendance_arbzg/models/res_company.py:0
msgid ""
"The limits of the Working Time Act must be positive, and the longer break "
"must come later and last at least as long as the first one."
msgstr "Die Grenzen des Arbeitszeitgesetzes müssen positiv sein, und die längere Pause muss später beginnen und mindestens so lang dauern wie die erste."

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.model.fields,field_description:l10n_de_hr_attendance_arbzg.field_res_company__arbzg_enabled
#: model:ir.model.fields,field_description:l10n_de_hr_attendance_arbzg.field_res_config_settings__arbzg_enabled
#: model_terms:ir.ui.view,arch_db:l10n_de_hr_attendance_arbzg.res_config_settings_view_form
msgid "Working Time Act (ArbZG)"
msgstr "Arbeitszeitgesetz (ArbZG)"

#. module: l10n_de_hr_attendance_arbzg
#: model_terms:ir.ui.view,arch_db:l10n_de_hr_attendance_arbzg.res_config_settings_view_form
msgid "Working Time Act (Germany)"
msgstr "Arbeitszeitgesetz (Deutschland)"

#. module: l10n_de_hr_attendance_arbzg
#: model:ir.actions.server,name:l10n_de_hr_attendance_arbzg.ir_cron_arbzg_auto_check_out_ir_actions_server
msgid "Working Time Act: Check Out at the Maximum"
msgstr "Arbeitszeitgesetz: bei Höchstarbeitszeit ausstempeln"

#. module: l10n_de_hr_attendance_arbzg
#: model:mail.activity.type,name:l10n_de_hr_attendance_arbzg.mail_activity_type_arbzg_maximum
msgid "Working Time Exceeded"
msgstr "Arbeitszeit überschritten"

#. module: l10n_de_hr_attendance_arbzg
#: model_terms:ir.ui.view,arch_db:l10n_de_hr_attendance_arbzg.res_config_settings_view_form
msgid "the attendance approver of the employee"
msgstr "der Genehmiger der Anwesenheiten"
