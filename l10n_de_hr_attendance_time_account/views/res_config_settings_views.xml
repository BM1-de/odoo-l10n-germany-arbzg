<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.time_account</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='attendance_settings']" position="after">
                <block
                    title="Working Time Account (Germany)"
                    name="time_account_settings"
                >
                    <setting
                        string="Working Time Account"
                        company_dependent="1"
                        help="Default for new contract versions: compare worked hours to the working schedule per day, week or month. Each employee can differ."
                    >
                        <field name="time_account_period" />
                    </setting>
                    <setting
                        string="Tolerance"
                        company_dependent="1"
                        help="Default for new contract versions: differences up to these hours are booked with zero."
                    >
                        <div class="d-flex gap-2">
                            <span>Plus</span>
                            <field
                                name="time_account_tolerance_plus"
                                widget="float_time"
                                class="w-25"
                            />
                            <span>Minus</span>
                            <field
                                name="time_account_tolerance_minus"
                                widget="float_time"
                                class="w-25"
                            />
                        </div>
                    </setting>
                    <setting
                        string="Book Minus Hours"
                        company_dependent="1"
                        help="Default for new contract versions. Minus hours need an agreement with the employee."
                    >
                        <field name="time_account_negative" />
                    </setting>
                    <setting
                        string="Closed Until"
                        company_dependent="1"
                        help="Set by closing a month under Attendances / Working Time Account."
                    >
                        <field name="time_account_lock_date" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
